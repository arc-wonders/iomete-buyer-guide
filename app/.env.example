# Optional. Without credentials the bot runs in retrieval mode (deterministic, fully tested).
# With a key, the model composes the two-sentence answer; the code still validates every
# citation and runs the refusal guard, falling back to retrieval on any violation.
# Gemini is used when its key is set, otherwise Claude, otherwise retrieval. BOT_ENGINE overrides.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# BOT_ENGINE=gemini     # gemini | claude | retrieval
# BOT_MODEL=gemini-3.7-flash   # or a Claude model id when BOT_ENGINE=claude
